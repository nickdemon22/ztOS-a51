#!/usr/bin/python3
"""Run a sudo command with a compositor password sheet when required."""
import os
import pwd
import subprocess
import sys
sys.path.insert(0, '/usr/local/lib')
from ztos_auth import Prompt

if len(sys.argv) < 2:
    sys.exit('Usage: ztos-auth COMMAND [ARGUMENT ...]')
if os.geteuid() == 0:
    os.execvp(sys.argv[1], sys.argv[1:])
env = dict(os.environ, LC_ALL='C')
prompt = None
try:
    cached = subprocess.run(['sudo', '-n', '-v'], stdout=subprocess.DEVNULL,
                            stderr=subprocess.DEVNULL, env=env).returncode == 0
    if not cached:
        prompt = Prompt()
        secret = prompt.password('Authenticate as ' + pwd.getpwuid(os.getuid()).pw_name + ' to run ' + os.path.basename(sys.argv[1]))
        for attempt in range(3):
            try:
                result = subprocess.run(['sudo', '-S', '-p', '', '-v'],
                    input=secret+b'\n', stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                    env=env, timeout=60)
            finally:
                secret[:] = b'\0' * len(secret)
            if result.returncode == 0:
                prompt.close(success=True); prompt = None
                break
            if b'incorrect password' not in result.stderr and b'Sorry, try again' not in result.stderr:
                prompt.send('FAIL', 'Authentication was denied for this account.')
                raise PermissionError('Authentication denied.')
            if attempt == 2:
                prompt.send('FAIL', 'Incorrect password. Authentication failed.')
                import time
                time.sleep(1)
                raise PermissionError('Incorrect password.')
            secret = prompt.retry()
        else:
            raise PermissionError('Authentication failed.')
    # Keep the same parent process for sudo's non-terminal timestamp ticket.
    sys.exit(subprocess.call(['sudo', '-n', '--'] + sys.argv[1:]))
except (OSError, InterruptedError, PermissionError, KeyError, subprocess.SubprocessError) as error:
    print('Authentication cancelled or failed: ' + str(error), file=sys.stderr)
    sys.exit(1)
finally:
    if prompt:
        prompt.close()
