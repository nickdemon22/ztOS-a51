// ztOS App Store (ztstore): the phone's owner may install signed packages from
// the repos without a password, as the Updates app may. A package built from
// the AUR, or taking an app off the phone, asks for the person's password
// through ztos-polkit-agent: either could change anything. Each person can
// only start their own unit (its name carries theirs). The gate is the same
// as the Updates app's (50-ztos-update.rules): the active local session, or a
// member of wheel (who can sudo anyway) -- the greetd session is not always
// flagged active, so requiring it blocked installs outright.
polkit.addRule(function (action, subject) {
	if (action.id != "org.freedesktop.systemd1.manage-units" ||
	    action.lookup("verb") != "start") {
		return polkit.Result.NOT_HANDLED;
	}
	var allowed = (subject.local && subject.active) || subject.isInGroup("wheel");
	if (!allowed) {
		return polkit.Result.NOT_HANDLED;
	}
	var unit = action.lookup("unit");
	if (unit == "ztstore-install@" + subject.user + ".service") {
		return polkit.Result.YES;
	}
	if (unit == "ztstore-admin@" + subject.user + ".service") {
		return polkit.Result.AUTH_SELF;
	}
	return polkit.Result.NOT_HANDLED;
});
