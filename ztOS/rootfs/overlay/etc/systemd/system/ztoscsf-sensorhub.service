[Unit]
Description=ztOSCoreSensorFramework, sensor hub: Broadcom's daemon for the Galaxy S9's BCM4773
After=multi-user.target

[Service]
ExecStartPre=/usr/local/sbin/ztoscsf-sensorhub
ExecStart=/usr/bin/chroot /run/android /vendor/bin/hw/lhd /vendor/etc/sensor/lhd.conf
Restart=on-failure
RestartSec=10

[Install]
WantedBy=graphical.target
